#!/usr/bin/env bash

set -euo pipefail

if [[ "${ASDF_SUPERDB_DEBUG:-false}" == "true" ]]; then set -x; fi

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=../lib/utils.bash
source "${plugin_dir}/lib/utils.bash"

versions=$(list_all_versions | sort_versions | uniq)

# Pre-release builds are versioned 0.YMMDD and all predate 0.1.0.
prerelease='^0\.[0-9]{5}$'
{
	grep -E "$prerelease" <<<"$versions" || true
	grep -vE "$prerelease" <<<"$versions" || true
} | xargs echo
