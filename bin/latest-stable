#!/usr/bin/env bash

set -euo pipefail

if [[ "${ASDF_SUPERDB_DEBUG:-false}" == "true" ]]; then set -x; fi

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=../lib/utils.bash
. "${plugin_dir}/lib/utils.bash"

curl_opts=(-sIL)

if [ -n "${GITHUB_API_TOKEN:-}" ]; then
	curl_opts=("${curl_opts[@]}" -H "Authorization: token $GITHUB_API_TOKEN")
fi

# releases/latest redirects to the tag URL, possibly after repo-rename redirects.
latest_url="$OFFICIAL_GH_REPO/releases/latest"
redirect_url=$(curl "${curl_opts[@]}" "$latest_url" | sed -n -e 's|^[Ll]ocation: *||p' | tr -d '\r' | tail -1) || true
version="$(printf "%s\n" "$redirect_url" | sed 's|.*/tag/v\{0,1\}||')"

[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
	fail "could not determine latest version from $latest_url (got '$redirect_url')"

printf "%s\n" "$version"
